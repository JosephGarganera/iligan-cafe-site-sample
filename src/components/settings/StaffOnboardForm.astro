---
// Clean frontmatter section
---
<div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 md:p-8 shadow-xl space-y-6 max-h-fit">
    <div>
        <h3 class="text-lg font-bold text-white tracking-tight">Onboard New Team Member</h3>
        <p class="text-xs text-slate-400 mt-1">Provision hardware-isolated operational account keys directly to the database layer.</p>
    </div>

    <!-- The Missing HTML Structural Interface Form -->
    <form id="staffOnboardForm" class="space-y-4">
        
        <!-- Field 1: Custom Operator Display Identifier -->
        <div class="space-y-1.5">
            <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Employee Display Name</label>
            <input 
                type="text" 
                id="employeeName" 
                placeholder="Juan Dela Cruz" 
                required 
                class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 transition-colors" 
            />
        </div>

        <!-- Field 2: Target Registry Connection Email -->
        <div class="space-y-1.5">
            <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Credentials Email Address</label>
            <input 
                type="email" 
                id="employeeEmail" 
                placeholder="operator@omnipos.io" 
                required 
                class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 transition-colors" 
            />
        </div>

        <!-- Field 3: Strict Network Access Password Key -->
        <div class="space-y-1.5">
            <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Account Entry Password</label>
            <input 
                type="password" 
                id="employeePassword" 
                placeholder="••••••••" 
                minlength="8" 
                required 
                class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 transition-colors" 
            />
        </div>

        <!-- Field 4: Role-Based Access Tier Dropdown Selection -->
        <div class="space-y-1.5">
            <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Operational Permission Rank</label>
            <select 
                id="employeeRole" 
                class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 transition-colors"
            >
                <option value="cashier">Store Cashier / Barista (Basic Entry Terminal)</option>
                <option value="manager">Manager Clearances (Catalog Modifications)</option>
                <option value="owner">Super-Admin Owner (Macro Finances Matrix)</option>
            </select>
        </div>

        <!-- Submission Trigger -->
        <button 
            type="submit" 
            id="staffSubmitBtn" 
            class="w-full mt-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm py-3.5 rounded-xl transition-all shadow-md hover:shadow-indigo-600/10 cursor-pointer"
        >
            Provision Employee Credentials
        </button>
    </form>
</div>

<!-- Streamlined, Error-Free Client Automation Controller Script -->
<script is:inline>
  (() => {
    function initializeStaffOnboardEngine() {
      const onboardForm = document.getElementById('staffOnboardForm');
      const submitBtn = document.getElementById('staffSubmitBtn');

      if (!onboardForm) {
        setTimeout(initializeStaffOnboardEngine, 50);
        return;
      }

      console.log("[FRONTEND LOG] Staff onboarding form listener successfully attached.");

      onboardForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const nameInput = document.getElementById('employeeName');
        const emailInput = document.getElementById('employeeEmail');
        const passwordInput = document.getElementById('employeePassword');
        const roleSelect = document.getElementById('employeeRole');

        const urlParams = new URLSearchParams(window.location.search);
        const activeTenant = urlParams.get('tenant') || 'cristina-crafts';

        if (!emailInput?.value || !passwordInput?.value) {
          alert("Please fill out all credential requirements fields completely.");
          return;
        }

        const originalText = submitBtn ? submitBtn.innerText : "Provision Employee Credentials";
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerText = "Transmitting Payload Gateway...";
        }

        const payload = {
          email: emailInput.value.trim(),
          password: passwordInput.value,
          displayName: nameInput ? nameInput.value.trim() : 'Store Staff',
          assignedRole: roleSelect ? roleSelect.value : 'cashier',
          tenantId: activeTenant
        };

        try {
          const response = await fetch('/api/auth/add-staff', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          const data = await response.json();

          if (response.status === 201 || data.success) {
            alert(`Employee Profile Saved Flawlessly!\nAccount registered in Supabase users table.`);
            onboardForm.reset();
            window.location.reload(); 
          } else {
            alert(`Pipeline Rejected: ${data.error || 'Server error occurred.'}`);
          }
        } catch (err) {
          alert(`Network Connection Fault: ${err.message}`);
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerText = originalText;
          }
        }
      });
    }

    initializeStaffOnboardEngine();
  })();
</script>
