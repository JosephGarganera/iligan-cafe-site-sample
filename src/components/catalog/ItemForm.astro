---
// src/components/catalog/ItemForm.astro
interface Props {
  entityId: string;
  skuCode: string;
  itemName: string;
}
const { entityId, skuCode, itemName } = Astro.props;
---

<div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-4 text-left">
  <div>
    <h4 class="text-sm font-bold text-white tracking-tight">Stock Replenishment Entry</h4>
    <p class="text-[11px] text-slate-400 mt-0.5">Logging inventory mutations for <strong class="text-indigo-400 font-mono">{skuCode}</strong> ({itemName})</p>
  </div>

  
    <div class="grid grid-cols-2 gap-3">
      <div class="space-y-1">
        <label class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Quantity Added</label>
        <input 
          type="number" 
          name="quantity" 
          min="1" 
          placeholder="50" 
          required 
          class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-xs text-slate-200 focus:outline-none focus:border-indigo-500"
        />
      </div>
      <div class="space-y-1">
        <label class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Unit Cost Price (₱)</label>
        <input 
          type="number" 
          name="costPrice" 
          step="0.01" 
          placeholder="120.00" 
          required 
          class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-xs text-slate-200 focus:outline-none focus:border-indigo-500"
        />
      </div>
    </div>

    <div class="space-y-1">
      <label class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Audit Log Notes</label>
      <input 
        type="text" 
        name="notes" 
        placeholder="Supplier Batch #44 - Received OK" 
        class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-xs text-slate-200 focus:outline-none focus:border-indigo-500"
      />
    </div>

    <button 
      type="submit" 
      class="w-full bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-xs py-2.5 rounded-xl transition-all cursor-pointer"
    >
      Commit Inventory Batch
    </button>
  </form>
</div>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-inventory-form]').forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const entityId = form.getAttribute('data-inventory-form');
        const submitBtn = form.querySelector('button[type="submit"]');
        
        const urlParams = new URLSearchParams(window.location.search);
        const activeTenant = urlParams.get('tenant') || document.body.getAttribute('data-tenant-token');

        const formData = new FormData(form);
        const quantity = parseInt(formData.get('quantity'));
        const costPrice = parseFloat(formData.get('costPrice'));
        const notes = formData.get('notes');

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerText = "Writing Ledger Block...";
        }

        try {
          const res = await fetch('/api/inventory/replenish', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              tenantId: activeTenant,
              entityId,
              quantity,
              costPrice,
              notes
            })
          });

          const data = await res.json();

          if (res.status === 201 || data.success) {
            alert(`Stock Ledger Entry Saved Flawlessly!\nInventory metrics appended to audit database.`);
            form.reset();
          } else {
            alert(`Stock Intake Rejected: ${data.error}`);
          }
        } catch (err) {
          alert(`Network Data Fault: ${err.message}`);
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerText = "Commit Inventory Batch";
          }
        }
      });
    });
  })();
</script>
