---
// src/components/catalog/InventoryList.astro
const { items } = Astro.props;
---
<div class="bg-slate-800/20 border border-slate-800/60 rounded-2xl p-6 space-y-4">
    <h3 class="text-sm font-bold text-slate-300">Active Offerings Catalog Registry ({items.length})</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {items.map(item => (
            <div class="bg-slate-950 border border-slate-800/80 p-4 rounded-xl flex justify-between items-center gap-4">
                <div class="flex items-center gap-3 min-w-0">
                    <img src={item.imageUrl || "/placeholder.jpg"} class="w-10 h-10 object-cover rounded-lg bg-slate-800 flex-shrink-0" />
                    <div class="min-w-0">
                        <h4 class="text-xs font-bold text-white truncate">{item.title}</h4>
                        <p class="text-[10px] text-indigo-400 font-bold mt-0.5">₱{parseFloat(item.price).toFixed(2)} • <span class="text-slate-400 font-normal uppercase">{item.category}</span></p>
                    </div>
                </div>
                <button data-delete-btn={item.id} class="text-red-400 hover:text-red-300 hover:bg-red-950/30 p-2 rounded-lg border border-transparent hover:border-red-900/50 text-xs font-bold transition-all cursor-pointer">
                    Delete
                </button>
            </div>
        ))}
    </div>
</div>
