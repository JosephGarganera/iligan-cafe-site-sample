---
// src/components/ProductCard.astro
const { item } = Astro.props;

// 1. Unpack our generalized multi-tenant catalog attributes safely with fallbacks
const { id, title, description, price, imageUrl, metadata } = item;

const formattedPrice = parseFloat(price || 0).toFixed(2);
const itemImage = imageUrl || '/placeholder.jpg';

// 2. Extract dynamic structural metadata options depending on the business type
// Examples: Cafe sizes array, Gym contract durations, or Retail stock variants
const sizeVariants = metadata?.sizes || metadata?.flavors || null;
const genericBadge = metadata?.duration_days ? `${metadata.duration_days} Days Pass` : null;
---

<div class="group bg-slate-800/40 border border-slate-800/80 rounded-2xl overflow-hidden hover:border-indigo-500/50 shadow-md hover:shadow-xl transition-all duration-300 flex flex-col justify-between h-full relative animate-in fade-in slide-in-from-bottom-3 duration-500">
    
    <!-- Image Card Container Header -->
    <div class="relative w-full h-56 bg-slate-950 overflow-hidden">
        <img 
            src={itemImage} 
            alt={title} 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100" 
        />
        
        <!-- Condition Badge Render -->
        {genericBadge && (
            <span class="absolute top-4 left-4 bg-indigo-600 text-white font-extrabold text-[10px] uppercase tracking-widest px-3 py-1 rounded-full shadow-md">
                {genericBadge}
            </span>
        )}
    </div>

    <!-- Core Copy Information Metadata Content Wrapper -->
    <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
        <div class="space-y-2">
            <div class="flex justify-between items-start gap-2">
                <h4 class="font-bold text-lg text-white group-hover:text-indigo-400 transition-colors line-clamp-1">{title}</h4>
                <div class="flex items-baseline text-indigo-400 font-black text-base shrink-0">
                    <span class="text-xs font-semibold mr-0.5">₱</span>
                    <span>{formattedPrice}</span>
                </div>
            </div>
            
            {description && (
                <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">{description}</p>
            )}
        </div>

        <!-- Polymorphic Meta Detail Injectors (Lists variants if present in the database row) -->
        <div class="pt-2">
            {sizeVariants && (
                <div class="flex gap-1.5 flex-wrap">
                    {sizeVariants.map((variant) => (
                        <span class="text-[10px] font-medium px-2 py-0.5 rounded bg-slate-900 text-slate-400 border border-slate-800">
                            {variant}
                        </span>
                    ))}
                </div>
            )}
            
            <!-- Standard Transaction Open Button -->
            <button 
                data-modal-trigger={id} 
                class="w-full mt-4 bg-slate-900 border border-slate-800 hover:border-indigo-500 group-hover:bg-indigo-600 group-hover:text-white text-slate-300 text-xs font-bold py-3 px-4 rounded-xl transition-all duration-200 text-center cursor-pointer shadow-sm">
                Interact & Acquire
            </button>
        </div>
    </div>
</div>
