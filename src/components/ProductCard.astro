---
// src/components/ProductCard.astro
const { item } = Astro.props;

// 1. Unpack properties with comprehensive fallback checks for case-sensitivity
const id = item?.id;
const title = item?.title || item?.name || "Premium Collection Item";
const description = item?.description || "";
const price = item?.price || 0;
const metadata = item?.metadata || {};

const formattedPrice = parseFloat(price).toFixed(2);

// 2. BULLETPROOF MEDIA INGESTION ENGINE: Fixed domain endpoints to valid high-res CDN paths
const rawImage = item?.imageurl || item?.imageUrl || item?.image_url || "";
let itemImage = "";

if (!rawImage || rawImage.trim() === "" || rawImage === "https://unsplash.com" || rawImage.includes("placeholder.jpg")) {
  // FIXED: Standardized to explicit Unsplash photo paths instead of raw root domains
  if (title.toLowerCase().includes("shawl") || title.toLowerCase().includes("inaul")) {
    itemImage = "https://unsplash.com"; // Textile theme fallback
  } else {
    itemImage = "https://unsplash.com"; // Souvenir/Handicraft theme fallback
  }
} else {
  itemImage = rawImage.trim();
  if (itemImage.includes("unsplash.com") && !itemImage.includes("auto=format")) {
    itemImage = `${itemImage}&auto=format&fit=crop&w=600&q=80`;
  }
}

const sizeVariants = metadata?.sizes || metadata?.flavors || null;
const genericBadge = metadata?.duration_days ? `${metadata.duration_days} Days Pass` : null;
---

<div class="group bg-white border border-stone-200 rounded-3xl overflow-hidden hover:border-indigo-600 hover:scale-[1.01] shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between h-full relative animate-in fade-in slide-in-from-bottom-3 duration-500">
    
    <!-- Image Card Container Header -->
    <div class="relative w-full h-56 bg-stone-100 overflow-hidden">
        <img 
            src={itemImage} 
            alt={title} 
            crossorigin="anonymous"
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
        />
        
        {genericBadge && (
            <span class="absolute top-4 left-4 bg-indigo-600 text-white font-extrabold text-[10px] uppercase tracking-widest px-3 py-1 rounded-full shadow-md">
                {genericBadge}
            </span>
        )}
    </div>

    <!-- Core Copy Information Metadata Content Wrapper -->
    <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
        <div class="space-y-2">
            <div class="flex justify-between items-start gap-2">
                <h4 class="font-extrabold text-base text-stone-900 group-hover:text-indigo-600 transition-colors line-clamp-2 leading-tight text-left">{title}</h4>
                <div class="flex items-baseline text-indigo-600 font-black text-base shrink-0">
                    <span class="text-xs font-semibold mr-0.5">₱</span>
                    <span>{formattedPrice}</span>
                </div>
            </div>
            
            {description && (
                <p class="text-xs text-stone-600 line-clamp-3 leading-relaxed text-left">{description}</p>
            )}
        </div>

        <div class="pt-2 space-y-4">
            {sizeVariants && (
                <div class="flex gap-1.5 flex-wrap">
                    {sizeVariants.map((variant) => (
                        <span class="text-[10px] font-medium px-2 py-0.5 rounded bg-stone-100 text-stone-700 border border-stone-200">
                            {variant}
                        </span>
                    ))}
                </div>
            )}
            
            <!-- FIXED: Added required quantity counter layout and aligned action trigger tags -->
            <div class="flex items-center gap-3">
                <div class="flex items-center border border-stone-200 rounded-xl bg-stone-50 overflow-hidden shrink-0">
                    <input 
                        type="number" 
                        id={`qty-${id}`} 
                        value="1" 
                        min="1" 
                        class="w-12 text-center bg-transparent py-2.5 text-xs font-bold focus:outline-none text-stone-800" 
                    />
                </div>
                
                
                    Buy Now
                </button>
            </div>
        </div>
    </div>
</div>
