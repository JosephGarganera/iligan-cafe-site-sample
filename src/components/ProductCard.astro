---
// src/components/ProductCard.astro
const { item, urlFor } = Astro.props;
---

<div class="bg-white rounded-3xl border border-stone-200/60 overflow-hidden flex flex-col justify-between group hover:border-amber-800/40 hover:shadow-xl hover:shadow-stone-950/[0.02] transition-all duration-300">
    <div class="relative overflow-hidden aspect-video bg-stone-100">
        {item.image ? (
            <img 
                src={urlFor(item.image).width(600).height(400).url()} 
                alt={item.name} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
            />
        ) : (
            <div class="w-full h-full flex items-center justify-center text-stone-400 text-xs font-medium">No Image Uploaded</div>
        )}
        <span class="absolute top-4 right-4 bg-[#FAF9F5]/90 backdrop-blur-md text-amber-950 font-serif font-black px-3 py-1 rounded-xl text-sm border border-stone-200/30">
            ₱{item.price}
        </span>
    </div>

    <div class="p-6 flex-1 flex flex-col justify-between">
        <div>
            <h5 class="text-lg font-extrabold text-stone-900 tracking-tight mb-2 group-hover:text-amber-900 transition-colors">
                {item.name}
            </h5>
            <p class="text-stone-500 text-xs md:text-sm leading-relaxed mb-6 font-normal">
                {item.description}
            </p>
        </div>
        
        <a 
            href={`https://m.me! I would like to order your delicious ${encodeURIComponent(item.name)}`} 
            target="_blank" 
            class="w-full block bg-stone-950 text-stone-100 text-center py-3 rounded-xl font-bold tracking-wider text-xs uppercase hover:bg-amber-950 hover:text-white transition duration-200"
        >
            Order via Messenger
        </a>
    </div>
</div>
