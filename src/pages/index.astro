---
import '../styles/global.css';
import { sanityClient } from '../utils/sanity.js';
import imageUrlBuilder from '@sanity/image-url';

const builder = imageUrlBuilder(sanityClient);
function urlFor(source) {
  return builder.image(source);
}

let items = [];
let activeStaff = [];

try {
  // Fetch active items ordered by sorting priority parameters cleanly
  items = await sanityClient.fetch(`*[_type == "menuItem" && isAvailable == true] | order(orderPriority desc)`);
  activeStaff = await sanityClient.fetch(`*[_type == "staffMember" && isOnShift == true]`);
} catch (error) {
  console.error("Live build database pull interrupted:", error);
}

const categories = [
  { id: 'coffee', name: '☕ Espresso & Coffee' },
  { id: 'non-coffee', name: '🥛 Non-Caffeinated' },
  { id: 'pastries', name: '🥐 Pastries & Breads' },
  { id: 'meals', name: '🍳 All-Day Meals' }
];

const businessName = "Chedings Copycat Cafe";
const contactNum = "09171234567";
const locationInfo = "Tibanga Highway, near MSU-IIT, Iligan City";
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{businessName} | Artisanal Coffee Oasis</title>
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,600;0,800;1,400&family=Playfair+Display:ital,wght@0,600;0,900;1,600&display=swap" rel="stylesheet">
    
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .font-serif { font-family: 'Playfair Display', serif; }
    </style>
</head>
<body class="bg-[#FAF9F5] text-stone-800 antialiased selection:bg-amber-100">

    <!-- Header Navigation Grid -->
    <header class="bg-[#FAF9F5]/70 backdrop-blur-xl border-b border-stone-200/50 sticky top-0 z-50 transition-all">
        <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
            <div class="flex flex-col">
                <span class="font-serif text-xl md:text-2xl font-black text-amber-900 tracking-tight">{businessName}</span>
                <span class="text-[10px] uppercase font-bold tracking-widest text-stone-400 mt-0.5">Iligan City</span>
            </div>
            <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-stone-600">
                <a href="#about" class="hover:text-amber-800 transition">Our Story</a>
                <a href="#menu-showcase" class="hover:text-amber-800 transition">The Menu</a>
                <a href="#location" class="hover:text-amber-800 transition">Find Us</a>
            </nav>
            <a href={`tel:${contactNum}`} class="bg-amber-950 text-amber-100 hover:bg-amber-900 px-5 py-2.5 rounded-full font-bold text-xs tracking-wider uppercase transition shadow-sm hover:shadow-md">
                Call Shop
            </a>
        </div>
    </header>

    <!-- Operational Shift Banner Layout Layer -->
    {activeStaff.length > 0 && (
    <div class="bg-gradient-to-r from-emerald-900 via-stone-900 to-emerald-950 text-emerald-100 py-3 px-6 border-b border-emerald-800/30">
        <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
            <div class="flex items-center gap-3">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
                </span>
                <p class="text-xs md:text-sm font-medium tracking-wide">
                    <span class="text-emerald-400 font-bold">Live Status:</span> We are open and brewing right now. Counter team: 
                    <span class="font-semibold text-white ml-0.5">
                        {activeStaff.map((staff, i) => `${staff.name}${i < activeStaff.length - 1 ? ', ' : ''}`)}
                    </span>
                </p>
            </div>
            <div class="flex -space-x-1.5 overflow-hidden">
                {activeStaff.map((staff) => staff.photo && (
                    <img class="inline-block h-7 w-7 rounded-full ring-2 ring-stone-900 object-cover" src={urlFor(staff.photo).width(64).height(64).url()} alt={staff.name} />
                ))}
            </div>
        </div>
    </div>
    )}

    <!-- Editorial Hero Showcase -->
    <section id="about" class="relative overflow-hidden py-24 md:py-32 px-6 border-b border-stone-200/40 bg-gradient-to-b from-stone-100/50 to-transparent">
        <div class="max-w-4xl mx-auto text-center relative z-10">
            <span class="text-xs uppercase font-extrabold tracking-widest text-amber-800 bg-amber-100/60 px-3 py-1 rounded-full border border-amber-200/30">Premium Neighborhood Hub</span>
            <h2 class="font-serif text-5xl md:text-7xl font-black text-stone-900 tracking-tight mt-6 mb-8 leading-[1.05]">
                Locally sourced. <br class="hidden sm:inline"/>Built for <span class="italic font-normal text-amber-800">digital builders</span>.
            </h2>
            <p class="text-stone-600 max-w-xl mx-auto text-base md:text-lg leading-relaxed mb-10 font-normal">
                Ditching commercial templates to bring Iligan City an authentic coffee house atmosphere. Drop by our tech-friendly sanctuary near MSU-IIT to refuel.
            </p>
            <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
                <a href="#menu-showcase" class="w-full sm:w-auto bg-amber-950 text-amber-50 px-8 py-4 rounded-xl font-bold text-sm hover:bg-amber-900 transition shadow-xl shadow-amber-950/10">
                    Explore Today's Menu
                </a>
                <a href="https://m.me" target="_blank" class="w-full sm:w-auto bg-white text-stone-800 border border-stone-200 px-8 py-4 rounded-xl font-bold text-sm hover:bg-stone-50 transition shadow-sm">
                    Pre-Order via Messenger
                </a>
            </div>
        </div>
        <div class="absolute top-1/2 left-1/4 -translate-y-1/2 -translate-x-1/2 w-96 h-96 bg-amber-100/20 rounded-full filter blur-3xl -z-10"></div>
        <div class="absolute bottom-0 right-1/4 w-72 h-72 bg-orange-100/20 rounded-full filter blur-3xl -z-10"></div>
    </section>

    <!-- The Dynamic Submenu Navigation & Grid Section -->
    <section id="menu-showcase" class="max-w-6xl mx-auto px-6 py-24">
        
        <div class="text-center md:text-left md:flex md:items-end md:justify-between border-b border-stone-200 pb-8 mb-12">
            <div>
                <h3 class="font-serif text-3xl md:text-4xl font-black text-stone-900 tracking-tight">On the Counter Today</h3>
                <p class="text-stone-400 text-sm mt-1">Real-time inventory managed straight from our workspace dashboard.</p>
            </div>
            
            <div class="flex flex-wrap justify-center gap-2 mt-6 md:mt-0">
                {categories.map((cat) => (
                    <a 
                        href={`#category-${cat.id}`}
                        class="text-xs font-bold px-4 py-2 rounded-full border border-stone-200 bg-white hover:border-amber-800 hover:text-amber-950 transition-all duration-200 shadow-xs"
                    >
                        {cat.name}
                    </a>
                ))}
            </div>
        </div>

        <!-- Render Structured Category Buckets cleanly without template errors -->
        <div>
            {categories.map((cat) => {
                // FIXED: Strict evaluation comparison operator applied to prevent syntax parser crash
                const dynamicCategoryItems = items.filter(item => item.category === cat.id);
                
                return dynamicCategoryItems.length > 0 && (
                    <div id={`category-${cat.id}`} class="mb-16 scroll-mt-24">
                        <div class="flex items-center gap-4 mb-8">
                            <h4 class="font-serif text-xl md:text-2xl font-black text-stone-900 tracking-tight">{cat.name}</h4>
                            <div class="h-[1px] bg-stone-200 flex-1"></div>
                        </div>

                        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
                            {dynamicCategoryItems.map((item) => (
                                <div class="bg-white rounded-3xl border border-stone-200/60 overflow-hidden flex flex-col justify-between group hover:border-amber-800/40 hover:shadow-xl hover:shadow-stone-950/[0.02] transition-all duration-300">
                                    
                                    <div class="relative overflow-hidden aspect-video bg-stone-100">
                                        {item.image ? (
                                            <img 
                                                src={urlFor(item.image).width(600).height(400).url()} 
                                                alt={item.name} 
                                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                                loading="lazy"
                                            />
                                        ) : (
                                            <div class="w-full h-full flex items-center justify-center text-stone-400 text-xs font-medium">No Image Uploaded</div>
                                        )}
                                        <span class="absolute top-4 right-4 bg-[#FAF9F5]/90 backdrop-blur-md text-amber-950 font-serif font-black px-3 py-1 rounded-xl text-sm border border-stone-200/30">
                                            ₱{item.price}
                                        </span>
{item.name}


{item.description}

<a
href={https://m.me! I would like to order your delicious ${encodeURIComponent(item.name)}}
target="_blank"
class="w-full block bg-stone-950 text-stone-100 text-center py-3 rounded-xl font-bold tracking-wider text-xs uppercase hover:bg-amber-950 hover:text-white transition duration-200"
>
Order via Messenger



))}


);
})}



{businessName}
📍 {locationInfo}

© 2026 Studio Factory Stack. Crafted locally in Iligan City.
