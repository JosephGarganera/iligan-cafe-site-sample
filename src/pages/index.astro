---
import '../styles/global.css';
import { fetchStoreData } from '../utils/queries.js';
import imageUrlBuilder from '@sanity/image-url';
import { sanityClient } from '../utils/sanity.js';
import Navbar from '../components/Navbar.astro';
import ShiftBanner from '../components/ShiftBanner.astro';
import ProductCard from '../components/ProductCard.astro';

// Initialize image configuration maps safely on the server
const builder = imageUrlBuilder(sanityClient);
function urlFor(source) { return builder.image(source); }

// Fetch pre-processed clean collections from our isolated query layer
const { items, activeStaff, themeSettings } = await fetchStoreData();

const categories = [
  { id: 'coffee', name: '☕ Our Drinks' },
  { id: 'non-coffee', name: '🥛 Sweet Sips' },
  { id: 'pastries', name: '🥐 Baked Goods' },
  { id: 'meals', name: '🍳 All-Day Plates' }
];

const recommendedItems = items.filter(item => item.isRecommended === true);
const structuredMenu = categories.map(cat => ({
  ...cat,
  products: items.filter(item => item.category === cat.id)
})).filter(cat => cat.products.length > 0);

const isDark = themeSettings.modeSelection === 'dark';
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{themeSettings.title} | Neighborhood Coffee</title>
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Plus Jakarta Sans', sans-serif; } .font-serif { font-family: 'Playfair Display', serif; } .scrollbar-none::-webkit-scrollbar { display: none; }</style>
</head>
<body class={`antialiased selection:bg-amber-200 min-h-screen flex flex-col justify-between ${isDark ? 'bg-stone-950 text-stone-200' : 'bg-[#FAF9F5] text-stone-800'}`}>

    <Navbar title={themeSettings.title} isDark={isDark} />
    <ShiftBanner activeStaff={activeStaff} urlFor={urlFor} />

     <!-- Hero Showcase Section -->
    <section class="relative bg-gradient-to-b from-stone-100 to-transparent py-24 px-6 text-center border-b border-stone-200/50">
        <div class="max-w-3xl mx-auto">
            <!-- FIXED: Brand text label now reads dynamically straight from Sanity metadata -->
            <span class="text-xs uppercase font-extrabold tracking-widest text-amber-900 bg-amber-100 px-4 py-1.5 rounded-full">
                {themeSettings.badgeText}
            </span>
            <h2 class="font-serif text-5xl md:text-7xl font-black tracking-tight mt-6 mb-8 text-stone-900">
                {themeSettings.tagline}
            </h2>
        </div>
    </section>

    <!-- Recommended for the Day Spotlight Board Section -->
    {recommendedItems.length > 0 && (
      <section class="bg-amber-50/30 border-b border-amber-200/20 py-16 px-6">
        <div class="max-w-6xl mx-auto">
          <div class="flex items-center gap-3 mb-10 justify-center md:justify-start">
            <span class="text-xl">⚡</span>
            <h3 class="font-serif text-3xl font-black tracking-tight text-stone-900">Recommended for the Day</h3>
          </div>
          <div class="grid sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {recommendedItems.map((p) => <ProductCard item={p} urlFor={urlFor} themeSettings={themeSettings} />)}
          </div>
        </div>
      </section>
    )}

    <!-- Tabbed Menu Segment -->
    <section id="menu-showcase" class="max-w-6xl w-full mx-auto px-4 md:px-6 py-20 flex-1">
        <div class={`flex justify-start md:justify-center gap-2 overflow-x-auto pb-3 mb-10 sticky top-[78px] z-40 backdrop-blur-md p-1.5 rounded-2xl scrollbar-none ${isDark ? 'bg-stone-950/90' : 'bg-[#FAF9F5]/90'}`}>
            {structuredMenu.map((cat, idx) => (
                <button data-target={`tab-pane-${cat.id}`} class={`tab-trigger shrink-0 text-xs font-bold px-6 py-3 rounded-full border transition-all duration-200 cursor-pointer ${idx === 0 ? 'bg-amber-950 text-amber-100 border-amber-950 shadow-md' : (isDark ? 'bg-stone-900 text-stone-400 border-stone-800' : 'bg-white text-stone-600 border-stone-200')}`}>{cat.name}</button>
            ))}
        </div>

        <div>
            {structuredMenu.map((cat, idx) => (
                <div id={`tab-pane-${cat.id}`} class={`tab-pane transition-all duration-300 grid sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-3 gap-8 ${idx === 0 ? 'block opacity-100' : 'hidden opacity-0 translate-y-2'}`}>
                    {cat.products.map((p) => <ProductCard item={p} urlFor={urlFor} themeSettings={themeSettings} />)}
                </div>
            ))}
        </div>
    </section>

    <footer class="bg-stone-900 text-stone-400 py-12 text-center text-xs">
        <span class="font-serif text-xl font-black text-stone-100 block mb-2">{themeSettings.title}</span>
        <p class="uppercase font-bold tracking-widest text-[9px] opacity-40">&copy; 2026 Modular Studio Customizer.</p>
    </footer>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const triggers = document.querySelectorAll('.tab-trigger');
            const panes = document.querySelectorAll('.tab-pane');
            triggers.forEach(trigger => {
                trigger.addEventListener('click', () => {
                    const targetId = trigger.getAttribute('data-target');
                    triggers.forEach(t => t.classList.remove('bg-amber-950', 'text-amber-100', 'border-amber-950', 'shadow-md'));
                    panes.forEach(p => p.classList.add('hidden', 'opacity-0', 'translate-y-2'));
                    trigger.classList.add('bg-amber-950', 'text-amber-100', 'border-amber-950', 'shadow-md');
                    const activePane = document.getElementById(targetId);
                    if (activePane) {
                        activePane.classList.remove('hidden');
                        setTimeout(() => { activePane.classList.remove('opacity-0', 'translate-y-2'); activePane.classList.add('opacity-100'); }, 30);
                    }
                });
            });
        });
    </script>
</body>
</html>
