---
// src/pages/index.astro (Keep top script logic exactly the same)
import '../styles/global.css';
import { fetchStoreData } from '../utils/queries.js';
import imageUrlBuilder from '@sanity/image-url';
import { sanityClient } from '../utils/sanity.js';
import Navbar from '../components/Navbar.astro';
import ShiftBanner from '../components/ShiftBanner.astro';
import ProductCard from '../components/ProductCard.astro';

const builder = imageUrlBuilder(sanityClient);
function urlFor(source) { return builder.image(source); }

const { items, activeStaff, themeSettings } = await fetchStoreData();

const categories = [
  { id: 'coffee', name: '☕ Our Drinks' },
  { id: 'non-coffee', name: '🥛 Sweet Sips' },
  { id: 'pastries', name: '🥐 Baked Goods' },
  { id: 'meals', name: '🍳 All-Day Plates' }
];

const recommendedItems = items.filter(item => item.isRecommended === true);
const structuredMenu = categories.map(cat => ({
  ...cat,
  products: items.filter(item => item.category === cat.id)
})).filter(cat => cat.products.length > 0);

// Global Seasonal Backdrops Controller
const currentSeason = themeSettings.seasonalTheme || 'summer';
const globalStyles = {
  summer: 'bg-[#FAF9F5] text-stone-800',
  rainy: 'bg-[#1E222A] text-slate-200',
  diyandi: 'bg-[#FFFDF9] text-stone-900',
  holiday: 'bg-[#14231C] text-stone-200'
};
const globalThemeClass = globalStyles[currentSeason] || globalStyles.summer;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{themeSettings.title} | Neighborhood Hub</title>
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Plus Jakarta Sans', sans-serif; } .font-serif { font-family: 'Playfair Display', serif; } .scrollbar-none::-webkit-scrollbar { display: none; }</style>
</head>
<body class={`antialiased selection:bg-amber-200 min-h-screen flex flex-col justify-between transition-colors duration-500 ${globalThemeClass}`}>

    <Navbar title={themeSettings.title} isDark={currentSeason === 'rainy' || currentSeason === 'holiday'} />
    <ShiftBanner activeStaff={activeStaff} urlFor={urlFor} />

    <!-- Hero Section -->
    <section class="relative py-24 px-6 text-center border-b border-stone-500/10">
        <div class="max-w-3xl mx-auto">
            <span class="text-xs uppercase font-extrabold tracking-widest text-amber-900 bg-amber-100 px-4 py-1.5 rounded-full">{themeSettings.badgeText}</span>
            <h2 class="font-serif text-5xl md:text-7xl font-black tracking-tight mt-6 mb-8">{themeSettings.tagline}</h2>
            {themeSettings.heroDescription && <p class="text-sm md:text-base opacity-70 max-w-xl mx-auto leading-relaxed">{themeSettings.heroDescription}</p>}
        </div>
    </section>

    <!-- Recommended for the Day Spotlight Board Section -->
    {recommendedItems.length > 0 && (
      <section class="bg-stone-500/5 border-b border-stone-500/10 py-16 px-6">
        <div class="max-w-6xl mx-auto">
          <div class="flex items-center gap-3 mb-10 justify-center md:justify-start">
            <span class="text-xl">⚡</span>
            <h3 class="font-serif text-3xl font-black tracking-tight">Recommended for the Day</h3>
          </div>
          <div class="grid sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {recommendedItems.map((p) => <ProductCard item={p} urlFor={urlFor} themeSettings={themeSettings} />)}
          </div>
        </div>
      </section>
    )}

    <!-- Tabbed Menu Segment -->
    <section id="menu-showcase" class="max-w-6xl w-full mx-auto px-4 md:px-6 py-20 flex-1">
        <div class={`flex justify-start md:justify-center gap-2 overflow-x-auto pb-3 mb-10 sticky top-[78px] z-40 backdrop-blur-md p-1.5 rounded-2xl scrollbar-none ${currentSeason === 'rainy' || currentSeason === 'holiday' ? 'bg-stone-900/90' : 'bg-[#FAF9F5]/90'}`}>
            {structuredMenu.map((cat, idx) => (
                <button data-target={`tab-pane-${cat.id}`} class={`tab-trigger shrink-0 text-xs font-bold px-6 py-3 rounded-full border transition-all duration-200 cursor-pointer ${idx === 0 ? 'bg-amber-950 text-amber-100 border-amber-950 shadow-md' : 'bg-stone-500/10 text-current border-stone-500/10'}`}>{cat.name}</button>
            ))}
        </div>

        <div>
            {structuredMenu.map((cat, idx) => (
                <div id={`tab-pane-${cat.id}`} class={`tab-pane transition-all duration-300 grid sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-3 gap-8 ${idx === 0 ? 'block opacity-100' : 'hidden opacity-0 translate-y-2'}`}>
                    {cat.products.map((p) => <ProductCard item={p} urlFor={urlFor} themeSettings={themeSettings} />)}
                </div>
            ))}
        </div>
    </section>

    <footer class="border-t border-stone-500/10 py-12 text-center text-xs opacity-60">
        <span class="font-serif text-xl font-black block mb-2">{themeSettings.title}</span>
        <p class="uppercase font-bold tracking-widest text-[9px]">&copy; 2026 Season Fluid Customizer Stack.</p>
    </footer>

    <!-- Tab & Modal Interactivity JavaScript Controller Script -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            // 1. Tab Navigation Toggles
            const triggers = document.querySelectorAll('.tab-trigger');
            const panes = document.querySelectorAll('.tab-pane');
            triggers.forEach(trigger => {
                trigger.addEventListener('click', () => {
                    const targetId = trigger.getAttribute('data-target');
                    triggers.forEach(t => t.classList.remove('bg-amber-950', 'text-amber-100', 'border-amber-950', 'shadow-md'));
                    panes.forEach(p => p.classList.add('hidden', 'opacity-0', 'translate-y-2'));
                    trigger.classList.add('bg-amber-950', 'text-amber-100', 'border-amber-950', 'shadow-md');
                    const activePane = document.getElementById(targetId);
                    if (activePane) {
                        activePane.classList.remove('hidden');
                        setTimeout(() => { activePane.classList.remove('opacity-0', 'translate-y-2'); activePane.classList.add('opacity-100'); }, 30);
                    }
                });
            });

            // 2. Split Screen Details Modal Actions
            const modalTriggers = document.querySelectorAll('[data-modal-trigger]');
            modalTriggers.forEach(t => {
                t.addEventListener('click', () => {
                    const id = t.getAttribute('data-modal-trigger');
                    const m = document.getElementById(`modal-target-${id}`);
                    const win = m?.querySelector('.modal-window');
                    if (m) {
                        m.classList.remove('hidden'); m.classList.add('flex'); document.body.style.overflow = 'hidden';
                        setTimeout(() => { m.classList.remove('opacity-0'); m.classList.add('opacity-100'); if(win) win.classList.remove('scale-95'); }, 20);
                    }
                });
            });

            const closeButtons = document.querySelectorAll('[data-modal-close]');
            closeButtons.forEach(b => {
                b.addEventListener('click', () => {
                    const id = b.getAttribute('data-modal-close');
                    const m = document.getElementById(`modal-target-${id}`);
                    const win = m?.querySelector('.modal-window');
                    if (m) {
                        if(win) win.classList.add('scale-95'); m.classList.remove('opacity-100'); m.classList.add('opacity-0'); document.body.style.overflow = '';
                        setTimeout(() => { m.classList.add('hidden'); m.classList.remove('flex'); }, 300);
                    }
                });
            });
        });
    </script>
</body>
</html>
