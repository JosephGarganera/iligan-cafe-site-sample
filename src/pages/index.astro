---
import '../styles/global.css';
import { sanityClient } from '../utils/sanity.js';
import imageUrlBuilder from '@sanity/image-url'; // Ensures image decoder library is bound

// Map the client credentials into Sanity's global image transformer
const builder = imageUrlBuilder(sanityClient);
function urlFor(source) {
  return builder.image(source);
}

let items = [];
let activeStaff = [];

try {
  items = await sanityClient.fetch(`*[_type == "menuItem" && isAvailable == true] | order(orderPriority desc)`);
  activeStaff = await sanityClient.fetch(`*[_type == "staffMember" && isOnShift == true]`);
} catch (error) {
  console.error("Database sync error:", error);
}

const businessName = "Chedings Copycat Cafe";
---
<!-- ... (Keep your header layouts completely untouched) ... -->

<!-- Dynamic Menu Layout Section -->
<section id="menu" class="max-w-6xl mx-auto px-4 py-20">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {items.map((item) => (
            <div class="bg-white rounded-2xl shadow-xs border border-slate-100 overflow-hidden flex flex-col justify-between hover:shadow-md transition duration-300">
                
                <!-- DYNAMIC IMAGE RESOLVER HANDSHAKE -->
                {item.image ? (
                    <img 
                        src={urlFor(item.image).width(600).height(400).url()} 
                        alt={item.name} 
                        class="w-full h-48 object-cover"
                    />
                ) : (
                    <div class="w-full h-48 bg-slate-100 flex items-center justify-center text-slate-400 text-xs">No Image Uploaded</div>
                )}

                <div class="p-6">
                    <div class="flex justify-between items-start gap-4 mb-3">
                        <h4 class="text-lg font-bold text-slate-900 tracking-tight">{item.name}</h4>
                        <span class="bg-red-50 text-red-600 font-black px-3 py-1 rounded-lg text-sm">₱{item.price}</span>
                    </div>
                    <p class="text-slate-500 text-sm leading-relaxed mb-4">{item.description}</p>
                    <a href="https://m.me" target="_blank" class="w-full block bg-slate-900 text-white text-center py-2.5 rounded-xl font-bold text-xs uppercase tracking-wide">Order via Messenger</a>
                </div>
            </div>
        ))}
    </div>
</section>
