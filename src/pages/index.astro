---
import '../styles/global.css';
import { sanityClient } from '../utils/sanity.js';
import imageUrlBuilder from '@sanity/image-url';
import ProductCard from '../components/ProductCard.astro';

const builder = imageUrlBuilder(sanityClient);
function urlFor(source) {
  return builder.image(source);
}

let items = [];
let activeStaff = [];
let rawSettings = null;

try {
  items = await sanityClient.fetch(`*[_type == "menuItem" && isAvailable == true] | order(orderPriority desc)`);
  activeStaff = await sanityClient.fetch(`*[_type == "staffMember" && isOnShift == true]`);
  // Fetch the latest global website customizer values
  rawSettings = await sanityClient.fetch(`*[_type == "siteSettings"][0]`);
} catch (error) {
  console.error("Live database configuration sync interrupted:", error);
}

// Fallback configuration if document settings remain uncreated
const themeSettings = rawSettings || {
  title: "Chedings Copycat Cafe",
  tagline: "Locally sourced treats. Crafted for digital builders.",
  modeSelection: "light",
  accentColor: "amber",
  shadowIntensity: "shadow-md",
  borderRadius: "rounded-xl"
};

const categories = [
  { id: 'coffee', name: '☕ Coffee' },
  { id: 'non-coffee', name: '🥛 Drinks' },
  { id: 'pastries', name: '🥐 Breads' },
  { id: 'meals', name: '🍳 Meals' }
];

const structuredMenu = categories.map(cat => {
  return {
    ...cat,
    products: items.filter(item => item.category === cat.id)
  };
}).filter(cat => cat.products.length > 0);

const isDark = themeSettings.modeSelection === 'dark';
const contactNum = "09171234567";
const locationInfo = "Tibanga Highway, near MSU-IIT, Iligan City";
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{themeSettings.title}</title>
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&family=Playfair+Display:ital,wght@0,900;1,600&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .font-serif { font-family: 'Playfair Display', serif; }
    </style>
</head>
<body class={`antialiased selection:bg-amber-200 transition-colors duration-300 min-h-screen flex flex-col justify-between ${isDark ? 'bg-stone-950 text-stone-200' : 'bg-[#FAF9F5] text-stone-800'}`}>

    <!-- Header Navigation -->
    <header class={`backdrop-blur-xl border-b sticky top-0 z-50 transition-all ${isDark ? 'bg-stone-950/80 border-stone-800/80' : 'bg-[#FAF9F5]/70 border-stone-200/50'}`}>
        <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
            <div class="flex flex-col">
                <span class="font-serif text-xl md:text-2xl font-black tracking-tight text-amber-600">{themeSettings.title}</span>
                <span class="text-[9px] uppercase font-bold tracking-widest text-stone-400 mt-0.5">Iligan City</span>
            </div>
            <a href={`tel:${contactNum}`} class={`px-5 py-2.5 rounded-full font-bold text-xs tracking-wider uppercase transition shadow-sm ${isDark ? 'bg-amber-400 text-stone-950 hover:bg-amber-300' : 'bg-stone-950 text-stone-100 hover:bg-amber-950'}`}>
                Call Now
            </a>
        </div>
    </header>

    <!-- Operational Shift Banner -->
    {activeStaff.length > 0 && (
    <div class={`py-3 px-6 border-b text-xs md:text-sm ${isDark ? 'bg-stone-900 border-stone-800 text-stone-300' : 'bg-emerald-50 border-emerald-100 text-emerald-800'}`}>
        <div class="max-w-6xl mx-auto flex justify-between items-center gap-3">
            <p class="font-medium tracking-wide">
                🟢 <span class="font-bold">Baristas On Duty:</span> {activeStaff.map((staff, i) => `${staff.name}${i < activeStaff.length - 1 ? ', ' : ''}`)}
            </p>
            <div class="flex -space-x-1.5 overflow-hidden">
                {activeStaff.map((staff) => staff.photo && (
                    <img class="inline-block h-6 w-6 rounded-full ring-2 ring-stone-900 object-cover" src={urlFor(staff.photo).width(64).height(64).url()} alt={staff.name} />
                ))}
            </div>
        </div>
    </div>
    )}

    <!-- Hero Showcase Section -->
    <section class="py-16 px-6 text-center max-w-3xl mx-auto">
        <h2 class="font-serif text-4xl md:text-6xl font-black tracking-tight leading-tight mb-6">
            {themeSettings.tagline}
        </h2>
        <p class={`text-sm md:text-base leading-relaxed max-w-xl mx-auto ${isDark ? 'text-stone-400' : 'text-stone-600'}`}>
            {themeSettings.heroDescription || 'Welcome to our specialized tech-friendly sanctuary. Enjoy premium items curated carefully by our expert crew.'}
        </p>
    </section>

    <!-- TABBED MENU ENGINE: Completely optimized to feel like a native app on mobile screens -->
    <section id="menu-showcase" class="max-w-6xl w-full mx-auto px-4 md:px-6 pb-24 flex-1">
        
        <!-- Mobile Horizontal Tab Bar (Anchors static to view context on mobile devices) -->
        <div class={`flex justify-start md:justify-center gap-2 overflow-x-auto pb-4 mb-8 sticky top-[68px] z-40 backdrop-blur-md p-2 rounded-2xl scrollbar-none ${isDark ? 'bg-stone-950/90' : 'bg-[#FAF9F5]/90'}`}>
            {structuredMenu.map((cat, index) => (
                <button 
                    data-target={`tab-pane-${cat.id}`}
                    class={`tab-trigger shrink-0 text-xs font-bold px-5 py-2.5 rounded-full border transition-all duration-200 shadow-xs cursor-pointer ${index === 0 ? 'bg-amber-600 text-white border-amber-600' : (isDark ? 'bg-stone-900 text-stone-300 border-stone-800' : 'bg-white text-stone-700 border-stone-200')}`}
                >
                    {cat.name} ({cat.products.length})
                </button>
            ))}
        </div>

        <!-- Render Structured Group Panes Controlled by our Client Tab Toggles -->
        <div class="relative">
            {structuredMenu.map((cat, index) => (
                <div 
                    id={`tab-pane-${cat.id}`} 
                    class={`tab-pane transition-all duration-300 grid sm:grid-cols-2 lg:grid-cols-3 gap-6 ${index === 0 ? 'block opacity-100 translate-y-0' : 'hidden opacity-0 translate-y-4'}`}
                >
                    {cat.products.map((p) => (
                        <ProductCard item={p} urlFor={urlFor} themeSettings={themeSettings} />
                    ))}
                </div>
            ))}
        </div>
    </section>

    <footer class={`text-center py-12 border-t px-6 text-xs ${isDark ? 'bg-stone-900 border-stone-800 text-stone-500' : 'bg-stone-100 border-stone-200 text-stone-400'}`}>
        <p class="font-bold mb-1">{themeSettings.title}</p>
        <p class="mb-4">📍 {locationInfo}</p>
        <p class="uppercase font-bold tracking-widest text-[9px] opacity-60">&copy; 2026 Studio Customizer Engine.</p>
    </footer>

    <!-- Native Interaction Switching Script (Runs client-side instantly for lightning-fast tab shifts) -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const triggers = document.querySelectorAll('.tab-trigger');
            const panes = document.querySelectorAll('.tab-pane');

            triggers.forEach(trigger => {
                trigger.addEventListener('click', () => {
                    const targetId = trigger.getAttribute('data-target');

                    // Reset active states for all tabs
                    triggers.forEach(t => {
                        t.classList.remove('bg-amber-600', 'text-white', 'border-amber-600');
                    });
                    
                    // Hide all content panes safely
                    panes.forEach(p => {
                        p.classList.add('hidden', 'opacity-0', 'translate-y-4');
                        p.classList.remove('block', 'opacity-100', 'translate-y-0');
                    });

                    // Highlight the chosen button tab state
                    trigger.classList.add('bg-amber-600', 'text-white', 'border-amber-600');
                    
                    // Activate and fade-in the targeted container panel view
                    const activePane = document.getElementById(targetId);
                    if (activePane) {
                        activePane.classList.remove('hidden');
                        setTimeout(() => {
                            activePane.classList.remove('opacity-0', 'translate-y-4');
                            activePane.classList.add('block', 'opacity-100', 'translate-y-0');
                        }, 50);
                    }
                });
            });
        });
    </script>
</body>
</html>
