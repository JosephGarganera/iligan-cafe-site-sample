---
// src/pages/index.astro
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0');
Astro.response.headers.set('Surrogate-Control', 'no-store');

import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import ShiftBanner from '../components/ShiftBanner.astro';
import { getStorefrontData } from '../utils/queries.js';

import PaywallScreen from '../components/store/PaywallScreen.astro';
import StorefrontHero from '../components/store/StorefrontHero.astro';
import ProductModal from '../components/store/ProductModal.astro';
import LiveOrderFeed from '../components/catalog/LiveOrderFeed.astro';
import ProductCard from '../components/ProductCard.astro';

const { tenantId } = Astro.locals;
const store = await getStorefrontData(tenantId);

// 1. RECTIFIED SAFE SECURITY GATES
if (!store || store.error) {
  return Astro.redirect('/404-tenant-not-found');
}

if (store.isSuspended) {
  Astro.response.status = 402; // Payment Required
}

const { businessName, businessType, layoutMode, colorTokens, catalogItems } = store;

// 2. Public placeholder CDN fallback utility
const urlFor = (source) => source || 'https://unsplash.com'; 

const primaryColor = colorTokens?.primary || '#800020';
const backgroundColor = colorTokens?.bg || '#FAF9F5';
const textColor = colorTokens?.text || '#1f2937';

const uniqueCategories = [...new Set((catalogItems || []).map((item) => item.category))];
const recommended = (catalogItems || []).filter((item) => item.metadata?.isRecommended === true || item.price > 1000);
---

{store.isSuspended ? (
  <PaywallScreen businessName={businessName} />
) : (
  <html lang="en" class="scroll-smooth">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>{businessName} | Powered by SaaS Engine</title>
      
      <!-- RESTORED: Professional Typography Fonts CDN Packages -->
      <link href="https://googleapis.com" rel="stylesheet" />
      
      <style define:vars={{ primaryColor, backgroundColor, textColor }}>
        :root { 
          --tenant-primary: var(--primaryColor); 
          --tenant-bg: var(--backgroundColor); 
          --tenant-text: var(--textColor); 
        }
        body { 
          background-color: var(--tenant-bg); 
          color: var(--tenant-text); 
          font-family: 'Plus Jakarta Sans', sans-serif; 
        }
        .font-serif { font-family: 'Playfair Display', serif; } 
        .accent-bg { background-color: var(--tenant-primary); }
      </style>
    </head>
    <body class="antialiased min-h-screen flex flex-col justify-between" data-tenant-token={tenantId}>
      
      <Navbar title={businessName} isDark={backgroundColor === '#1E222A'} />
      <ShiftBanner activeStaff={[]} urlFor={urlFor} />
      <StorefrontHero businessName={businessName} businessType={businessType} />

      <main class="max-w-7xl mx-auto w-full px-4 md:px-6 py-16 grid grid-cols-1 lg:grid-cols-3 gap-8 flex-1">
        
        <!-- Catalog Display Stream: Spans 2 full columns -->
        <section class="lg:col-span-2 space-y-12">
          <div class="text-left">
            <h2 class="text-2xl font-black text-white tracking-tight font-serif mb-2">Available Collection & Artifacts</h2>
            <p class="text-xs text-slate-400">Browse through our authentic local listings. Every checkout transaction verified securely at the server edge layer.</p>
          </div>

          <!-- FIXED UNNESTED DATA MAPPING LOOP -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {catalogItems && catalogItems.map((p) => (
              <ProductCard item={p} urlFor={urlFor} themeSettings={{}} />
            ))}
          </div>

          {(!catalogItems || catalogItems.length === 0) && (
            <div class="p-12 text-center border border-dashed border-slate-800 rounded-3xl bg-slate-900/30">
              <p class="text-xs text-slate-500 font-mono">No active catalog entities resolved for this client partition space.</p>
              <p class="text-[10px] text-slate-600 font-mono mt-1">Execute a database seed update or verify the 'is_visible' column parameters.</p>
            </div>
          )}
        </section>

        <!-- Real-Time POS terminal display sidebar card -->
        <aside class="w-full lg:sticky lg:top-24 h-fit">
          <LiveOrderFeed tenantId={tenantId} initialOrders={[]} />
        </aside>

      </main>

      <footer class="border-t border-slate-900 py-12 text-center text-xs opacity-60 bg-slate-950/20">
        <span class="font-serif text-xl font-black block mb-2 text-white">{businessName}</span>
        <p class="uppercase font-bold tracking-widest text-[9px]">&copy; 2026 Polymorphic Multi-Tenant SaaS Systems Network.</p>
      </footer>

      {catalogItems.map((p) => <ProductModal item={p} />)}
      <script src="/js/storefront.js" is:inline></script>
    </body>
  </html>
)}
