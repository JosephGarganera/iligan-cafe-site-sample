---
// src/pages/dashboard.astro
import '../styles/global.css';
import { getTenantDashboardMetrics } from '../utils/queries.js';

// 1. Force the edge proxy to skip server-side content caching for financial auditing
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, max-age=0');

// 2. Read the tenant query parameter from the URL string
const url = new URL(Astro.request.url);
const tenantId = url.searchParams.get('tenant') || 'the-tavern';


// THIS STRIPS THE PARAMETER AND SIMULATES AN ACTIVE ACCOUNT SECURITY CHECK
const currentRole = url.searchParams.get('role') || 'owner'; 

// 3. Resolve secure accounting calculations out of our database wrapper
const data = await getTenantDashboardMetrics(tenantId);
const { metrics, ledger } = data;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Business Analytics Management Studio</title>
    <link href="https://googleapis.com" rel="stylesheet">
    <style>body { font-family: 'Plus Jakarta Sans', sans-serif; }</style>
    <link href="https://googleapis.com" rel="stylesheet">
    
    <!-- Inject Global Browser Supabase SDK Worker Core -->
    <script src="https://jsdelivr.net"></script>
    
    <!-- Initialize Global Supabase Keys for Client Browser Listeners -->
    <script is:inline define:vars={{ 
        url: import.meta.env.PUBLIC_SUPABASE_URL, 
        key: import.meta.env.PUBLIC_SUPABASE_ANON_KEY 
    }}>
        window.supabase = window.supabase ? window.supabase : supabase.createClient(url, key);
    </script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen antialiased">

    <!-- Top Dashboard Context Bar -->
    <header class="border-b border-slate-800 bg-slate-900/50 backdrop-blur sticky top-0 z-50 p-6 flex justify-between items-center">
        <div>
            <h1 class="text-xl font-bold tracking-tight text-white">SaaS Administrative Dashboard</h1>
            <p class="text-xs text-slate-400 mt-1">Tenant Instance Isolation Mode: <span class="text-indigo-400 font-mono font-bold uppercase">{tenantId}</span></p>
        </div>
        <button id="downloadCSV" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs px-4 py-2.5 rounded-lg shadow transition-all cursor-pointer">
            Export Bookkeeping CSV
        </button>
    </header>

    <main class="max-w-7xl mx-auto p-6 md:p-8 space-y-8">
        
       <!-- Metrics Ribbon Block -->
{metrics ? (
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- CARD 1: Gross Running Earnings Metric (Owner Locked Layer) -->
        {currentRole === 'owner' ? (
            <div class="bg-slate-800/50 border border-slate-800 rounded-2xl p-6 shadow-sm animate-in fade-in duration-300">
                <span class="text-xs uppercase font-extrabold tracking-widest text-slate-400 block mb-2">Gross Running Volume</span>
                <div class="flex items-baseline gap-1 text-3xl font-black text-emerald-400">
                    <span class="text-xl font-medium">₱</span>
                    <span>{metrics.totalRevenue}</span>
                </div>
            </div>
        ) : (
            <div class="bg-slate-800/20 border border-slate-800/40 rounded-2xl p-6 shadow-sm flex items-center justify-center opacity-60">
                <p class="text-xs text-slate-400 italic font-medium flex items-center gap-2">
                    🔒 Financial Metrics restricted to Owner Clearance level.
                </p>
            </div>
        )}

        <!-- CARD 2: Total Platform Log Entries (Public Staff Accessible Layer) -->
        <div class="bg-slate-800/50 border border-slate-800 rounded-2xl p-6 shadow-sm">
            <span class="text-xs uppercase font-extrabold tracking-widest text-slate-400 block mb-2">System Interaction Events</span>
            <span class="text-3xl font-black text-indigo-400">{metrics.totalInteractions}</span>
        </div>

    </div>
) : (
    <div class="bg-red-950/30 border border-red-900 text-red-200 rounded-xl p-4 text-sm">Security Assertion Layer Exception: Unable to resolve authenticated credentials block.</div>
)}


        <!-- Real-Time Activity Log Ledger -->
        <div class="bg-slate-800/30 border border-slate-800/80 rounded-2xl overflow-hidden shadow-sm">
            <div class="p-6 border-b border-slate-800 flex justify-between items-center">
                <h2 class="font-bold text-base text-white">Universal Transaction & Form Ledger</h2>
                <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400 px-2 py-0.5 rounded border border-slate-700 bg-slate-800">Live Stream Active</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-300">
                    <thead class="text-xs uppercase tracking-wider text-slate-400 bg-slate-800/50 border-b border-slate-800">
                        <tr>
                            <th class="px-6 py-4 font-semibold">Event ID</th>
                            <th class="px-6 py-4 font-semibold">Classification</th>
                            <th class="px-6 py-4 font-semibold">Financial Value</th>
                            <th class="px-6 py-4 font-semibold">Payment Status</th>
                            <th class="px-6 py-4 font-semibold">Timestamp</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800">
                        {ledger && ledger.length > 0 ? ledger.map((row) => (
                            <tr class="hover:bg-slate-800/20 transition-colors">
                                <td class="px-6 py-4 font-mono text-xs text-slate-400">{row.id.substring(0, 8)}...</td>
                                <td class="px-6 py-4">
                                    <span class={`px-2.5 py-1 rounded-full text-[10px] font-bold tracking-wide uppercase ${
                                        row.interaction_type === 'SALE' ? 'bg-emerald-950 text-emerald-400 border border-emerald-900' : 'bg-blue-950 text-blue-400 border border-blue-900'
                                    }`}>
                                        {row.interaction_type}
                                    </span>
                                </td>
                                <td class="px-6 py-4 font-bold text-slate-200">₱{parseFloat(row.total_value).toFixed(2)}</td>
                                <td class="px-6 py-4 uppercase font-bold text-xs tracking-wider">{row.payment_status}</td>
                                <td class="px-6 py-4 text-xs text-slate-400">{new Date(row.created_at).toLocaleString('en-US', { timeZone: 'Asia/Manila' })}</td>
                            </tr>
                        )) : (
                            <tr>
                                <td colspan="5" class="px-6 py-12 text-center text-slate-500 text-sm">No transaction historical logs recorded in this cloud workspace partition.</td>
                            </tr>
                        )}
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- Client-Side Excel Bookkeeping Export Worker Logic Script Engine -->
       <!-- Unified Client-Side Export & Real-Time Sync Engine -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            // 1. Resolve localized tenant parameters from the active window context
            const urlParams = new URLSearchParams(window.location.search);
            const currentTenant = urlParams.get('tenant') || 'the-tavern';

            // 2. CSV Accounting Exporter Pipeline Workflows
            document.getElementById('downloadCSV')?.addEventListener('click', () => {
                // Read rows directly from the active visible DOM table to handle exports safely
                const rows = document.querySelectorAll('tbody tr');
                if (!rows || rows.length === 0 || rows[0].innerText.includes('No transaction')) {
                    return alert('No active financial matrix structures available to compile.');
                }
                
                let csvContent = "data:text/csv;charset=utf-8,Classification,Value,Status\n";
                rows.forEach(tr => {
                    const cells = tr.querySelectorAll('td');
                    if (cells.length >= 4) {
                        const type = cells[1].innerText.trim();
                        const val = cells[2].innerText.replace('₱', '').trim();
                        const status = cells[3].innerText.trim();
                        csvContent += `${type},${val},${status}\n`;
                    }
                });
                
                const encodedUri = encodeURI(csvContent);
                const link = document.createElement("a");
                link.setAttribute("href", encodedUri);
                link.setAttribute("download", `SaaS_Ledger_Export_${currentTenant}_${new Date().toISOString().slice(0,10)}.csv`);
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            });

            // 3. Supabase Real-Time Streaming Ledger Engine
            // Confirm the global connection layer is established before initializing a stream channel socket
            if (typeof supabase !== 'undefined') {
                supabase
                    .channel('live-ledger-feed')
                    .on(
                        'postgres_changes',
                        {
                            event: 'INSERT',
                            schema: 'public',
                            table: 'tenant_ledger',
                            filter: `tenant_id=eq.${currentTenant}`
                        },
                        (payload) => {
                            console.log('New interaction event intercepted live:', payload);
                            
                            // Play audio notification chime cue
                            const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                            const osc = audioCtx.createOscillator();
                            const gain = audioCtx.createGain();
                            osc.type = 'sine';
                            osc.frequency.setValueAtTime(587.33, audioCtx.currentTime); // D5 alert pitch
                            gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
                            osc.connect(gain);
                            gain.connect(audioCtx.destination);
                            osc.start();
                            osc.stop(audioCtx.currentTime + 0.15);

                            // Dynamically append new elements onto active transaction logs row grid
                            const tableBody = document.querySelector('tbody');
                            
                            // Remove empty fallback placeholder rows if present
                            if (tableBody && tableBody.innerText.includes('No transaction')) {
                                tableBody.innerHTML = '';
                            }

                            const newRow = document.createElement('tr');
                            newRow.className = 'hover:bg-slate-800/20 transition-colors animate-pulse bg-indigo-950/30 border-b border-slate-800';
                            
                            const rowData = payload.new;
                            
                            newRow.innerHTML = `
                                <td class="px-6 py-4 font-mono text-xs text-slate-400">${rowData.id.substring(0, 8)}...</td>
                                <td class="px-6 py-4">
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold tracking-wide uppercase bg-indigo-950 text-indigo-400 border border-indigo-900">
                                        ${rowData.interaction_type}
                                    </span>
                                </td>
                                <td class="px-6 py-4 font-bold text-slate-200">₱${parseFloat(rowData.total_value).toFixed(2)}</td>
                                <td class="px-6 py-4 uppercase font-bold text-xs tracking-wider text-emerald-400">${rowData.payment_status}</td>
                                <td class="px-6 py-4 text-xs text-slate-400">Just Now</td>
                            `;

                            if (tableBody && tableBody.firstChild) {
                                tableBody.insertBefore(newRow, tableBody.firstChild);
                            } else if (tableBody) {
                                tableBody.appendChild(newRow);
                            }
                        }
                    )
                    .subscribe();
            } else {
                console.warn("Supabase initialization global tracking client script was not loaded on this window lifecycle view.");
            }
        });
    </script>
</body>
</html>
