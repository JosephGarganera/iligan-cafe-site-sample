---
// src/pages/dashboard.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import { getTenantDashboardMetrics, verifyUserStaffClearance } from '../utils/queries.js';

// 1. Authenticate user access clearance bounds
const { tenantId } = Astro.locals;
// For mock deployment, we simulate an active owner identity hash string 
const activeUserUuid = "mock-testing-owner-id"; 

const clearance = await verifyUserStaffClearance(activeUserUuid, tenantId);
const dashboardData = await getTenantDashboardMetrics(tenantId);

// 2. High-performance calculations for SVG line-chart plotting vectors
const ledger = dashboardData.ledger || [];
const metrics = dashboardData.metrics || { totalRevenue: "0.00", totalInteractions: 0 };

// Map out the last 7 transaction values dynamically into a scalable geometric path array
const rawPoints = ledger.slice(0, 7).reverse().map(entry => parseFloat(entry.total_value || 0));
const maxVal = Math.max(...rawPoints, 100); // Prevent divide-by-zero errors if ledger is sparse

// Map array variables securely to pixel height markers inside a 100px high SVG canvas coordinate matrix
const svgHeight = 100;
const svgWidth = 500;
const pointsCount = rawPoints.length;

const chartCoordinates = rawPoints.map((val, idx) => {
  const x = pointsCount > 1 ? (idx / (pointsCount - 1)) * svgWidth : 0;
  const y = svgHeight - ((val / maxVal) * svgHeight);
  return `${x},${y}`;
});

const polylinePath = chartCoordinates.join(' ');
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Owner Analytics Matrix Center</title>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen font-sans antialiased">

    <Navbar title="OmniPOS Control Panel" isDark={true} />

    <main class="max-w-7xl mx-auto px-4 md:px-6 py-12 space-y-10">
        
        <!-- Header Banner Component Matrix -->
        <div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-slate-800 pb-6 gap-4">
            <div>
                <h1 class="text-3xl font-extrabold tracking-tight text-white">System Ledger Dashboard</h1>
                <p class="text-slate-400 text-sm mt-1">Real-time financial performance matrices compiled straight from the tenant isolation node.</p>
            </div>
            
            <div class="flex gap-2">
                <button id="export-csv-btn" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white text-xs font-bold px-4 py-2.5 rounded-xl cursor-pointer transition-all active:scale-95">
                    Export Bookkeeping CSV
                </button>
            </div>
        </div>

        <!-- Metric Macro Cards Summary Row Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-2 shadow-xl">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block">Gross Enterprise Earnings</span>
                <div class="flex items-baseline gap-1.5">
                    <span class="text-3xl font-black text-white tracking-tight">₱{metrics.totalRevenue}</span>
                    <span class="text-xs font-mono text-emerald-400 bg-emerald-950/50 border border-emerald-900 px-1.5 py-0.5 rounded">+14.2%</span>
                </div>
            </div>

            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-2 shadow-xl">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block">Total Transaction Velocity</span>
                <span class="text-3xl font-black text-white tracking-tight block">{metrics.totalInteractions}</span>
            </div>

            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-2 shadow-xl">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block">Active Clearance Role</span>
                <span class="text-3xl font-black text-indigo-400 tracking-tight block uppercase">{clearance.role || 'OWNER'}</span>
            </div>
        </div>

        <!-- Advanced Server-Side Rendered Vector Data Chart Canvas -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4">
            <div>
                <h3 class="text-base font-bold text-white tracking-tight">Transaction Velocity Stream</h3>
                <p class="text-xs text-slate-400">Visual trends curve tracking historical transactional events mapped relative to scaling peaks.</p>
            </div>

            {pointsCount > 1 ? (
              <div class="pt-4 h-48 w-full flex items-end">
                <svg viewBox={`0 0 ${svgWidth} ${svgHeight}`} class="w-full h-full overflow-visible drop-shadow-[0_4px_12px_rgba(99,102,241,0.15)]" preserveAspectRatio="none">
                    <!-- Smooth linear bounding guide meshes -->
                    <line x1="0" y1="0" x2={svgWidth} y2="0" stroke="#1e293b" stroke-width="1" stroke-dasharray="4" />
                    <line x1="0" y1="50" x2={svgWidth} y2="50" stroke="#1e293b" stroke-width="1" stroke-dasharray="4" />
                    <line x1="0" y1="100" x2={svgWidth} y2="100" stroke="#334155" stroke-width="1" />
                    
                    <!-- Dynamic Glowing Core Stroke Geometry Curve Vector -->
                    <polyline fill="none" stroke="#6366f1" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" points={polylinePath} />
                </svg>
              </div>
            ) : (
              <div class="py-12 text-center text-xs text-slate-500 font-mono">Insufficient point aggregates inside this time framework bucket. Run mock checkouts to stream real-time chart vector trails.</div>
            )}
        </div>

    </main>

    <!-- Passing server data tokens straight down into secure client download modules -->
    <script define:vars={{ ledgerJsonString: JSON.stringify(ledger) }}>
        document.getElementById('export-csv-btn')?.addEventListener('click', () => {
            const dataLake = JSON.parse(ledgerJsonString);
            if (!dataLake.length) return alert('No logging datasets to stream.');

            // Transform raw JSON arrays directly into safe RFC-compliant CSV text rows
            const headers = ['Transaction ID', 'Total Value (PHP)', 'Interaction Type', 'Created Date'];
            const contentRows = dataLake.map(row => [
                `"${row.id}"`,
                `"${row.total_value}"`,
                `"${row.interaction_type || 'SALE'}"`,
                `"${row.created_at}"`
            ].join(','));

            const csvStringContent = [headers.join(','), ...contentRows].join('\n');
            const dataBlob = new Blob([csvStringContent], { type: 'text/csv;charset=utf-8;' });
            
            const linkNode = document.createElement('a');
            linkNode.href = URL.createObjectURL(dataBlob);
            linkNode.setAttribute('download', `OmniPOS-Ledger-Report-${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(linkNode);
            linkNode.click();
            document.body.removeChild(linkNode);
        });
    </script>
</body>
</html>
