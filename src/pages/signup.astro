---
// src/pages/signup.astro
import '../styles/global.css';

Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, max-age=0');
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Onboard Your Business | Universal SaaS Network</title>
    <link href="https://googleapis.com" rel="stylesheet">
    <style>body { font-family: 'Plus Jakarta Sans', sans-serif; }</style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex items-center justify-center p-4 antialiased">

    <div class="w-full max-w-xl bg-slate-900 border border-slate-800 rounded-3xl p-8 md:p-10 shadow-2xl space-y-8 animate-in fade-in zoom-in-95 duration-300">
        
        <!-- Header Messaging -->
        <div class="text-center space-y-2">
            <h1 class="text-3xl font-black tracking-tight text-white">Deploy Your Platform</h1>
            <p class="text-sm text-slate-400">Launch a multi-tenant business instance instantly with zero upfront costs.</p>
        </div>

        <!-- Registration Form Layout -->
        <form id="signupForm" class="space-y-6">
            
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-2">
                    <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Business Name</label>
                    <input type="text" id="businessName" placeholder="The Tavern" required class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3.5 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 transition-colors" />
                </div>
                <div class="space-y-2">
                    <label class="text-xs font-bold uppercase tracking-wider text-slate-400">URL Routing Slug</label>
                    <input type="text" id="slug" placeholder="the-tavern" required class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3.5 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 font-mono transition-colors" />
                </div>
            </div>

            <!-- Classification Selection -->
            <div class="space-y-2">
                <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Industry Classification</label>
                <select id="businessType" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3.5 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 transition-colors">
                    <option value="F&B">Food & Beverage / Cafe</option>
                    <option value="Retail">Boutique Clothing / Retail Store</option>
                    <option value="Booking">Medical / Professional Booking System</option>
                    <option value="Portfolio">Local Service Provider Portfolio</option>
                </select>
            </div>

            <!-- Boundary Divider Line -->
            <div class="relative flex py-2 items-center">
                <div class="flex-grow border-t border-slate-800"></div>
                <span class="flex-shrink mx-4 text-[10px] font-bold uppercase tracking-widest text-slate-500">Admin Account Credentials</span>
                <div class="flex-grow border-t border-slate-800"></div>
            </div>

            <!-- Grid Partition: Security Profiles -->
            <div class="space-y-4">
                <div class="space-y-2">
                    <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Manager Email Address</label>
                    <input type="email" id="email" placeholder="manager@business.com" required class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3.5 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 transition-colors" />
                </div>
                <div class="space-y-2">
                    <label class="text-xs font-bold uppercase tracking-wider text-slate-400">Account Password</label>
                    <input type="password" id="password" placeholder="••••••••" minlength="8" required class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3.5 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 transition-colors" />
                </div>
            </div>

            <!-- Submit Core Command Button -->
            <button type="submit" id="submitBtn" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm py-4 rounded-xl transition-all shadow-md hover:shadow-indigo-600/10 cursor-pointer">
                Initialize Instant Go-Live Workflow
            </button>
        </form>
    </div>

    <!-- Client-Side Automation Pipeline Handler Script -->
    <script is:inline>
        document.getElementById('signupForm')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const submitBtn = document.getElementById('submitBtn');
            const payload = {
                businessName: document.getElementById('businessName').value,
                slug: document.getElementById('slug').value.toLowerCase().trim().replace(/[^a-z0-0-_]/g, '-'),
                businessType: document.getElementById('businessType').value,
                email: document.getElementById('email').value,
                password: document.getElementById('password').value
            };

            submitBtn.innerText = "Provisioning Platform Infrastructure...";
            submitBtn.disabled = true;

            try {
                const res = await fetch('/api/auth/register-tenant', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();
                
                if (res.ok && data.success) {
                    alert(`Initialization Complete! Your isolated space is ready.\n\nStorefront Sandbox URL: http://localhost:4321/?tenant=${payload.slug}\nAdmin Dashboard URL: http://localhost:4321/dashboard?tenant=${payload.slug}`);
                    window.location.href = `/dashboard?tenant=${payload.slug}`;
                } else {
                    alert(`Provisioning Interrupted: ${data.error || 'System anomaly occurred.'}`);
                }
            } catch (err) {
                alert(`Network Pipeline Failure: ${err.message}`);
            } finally {
                submitBtn.innerText = "Initialize Instant Go-Live Workflow";
                submitBtn.disabled = false;
            }
        });
    </script>
</body>
</html>
